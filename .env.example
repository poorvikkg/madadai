# MadadAI Configuration Template

# Server & App
PROJECT_NAME="MadadAI Resolution Platform"
DEBUG=False
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL with pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madadai
# Fallback for local testing without Postgres daemon: sqlite:///./madadai.db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=True
CACHE_DEFAULT_TTL=300

# Vector Dimension (must match embedding model dimension)
VECTOR_DIMENSION=384
DEFAULT_TOP_K=5
RRF_K=60

# Embeddings: "local", "sentence_transformers", or "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_API_KEY=sk-... (optional, only when using openai)

# LLM: "mock" (built-in grounded synthesizer), "openai", or "ollama"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-... (optional, only when using openai)

# Reranker: "none", "local_cross_encoder", "cohere"
RERANKER_PROVIDER=none
# RERANKER_API_KEY=... (optional)

# Uploads
MAX_UPLOAD_SIZE_MB=15
VITE_API_URL=http://localhost:8000
